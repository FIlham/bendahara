# Salin ke .env lokal (jangan commit). Di Vercel: set di
# Project Settings → Environment Variables (Production + Preview).
# JANGAN beri prefix VITE_ pada secret di bawah ini.

# Random string panjang untuk Better Auth session encryption.
BETTER_AUTH_SECRET=
# URL publik aplikasi, tanpa trailing slash.
# Lokal: http://localhost:3000
# Production: https://<domain-anda>
BETTER_AUTH_URL=http://localhost:3000
# Postgres connection string. Untuk serverless, pakai endpoint pooler
# dari penyedia (Neon/Supabase/pgBouncer), tambahkan ?sslmode=require
# bila penyedia serverless membutuhkannya.
DATABASE_URL=postgresql://user:password@localhost:5432/bendahara
# Opsional: batasi koneksi pg.Pool per instance serverless (default 5).
PGPOOL_MAX=5
# Google OAuth (console.cloud.google.com). Redirect URI yang didaftarkan
# harus persis: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# API publik /api/v1 untuk bot atau service pihak ketiga (opsional).
# Tanpa dua nilai ini, semua endpoint /api/v1 menjawab 503.
# API_KEY: string acak panjang (mis. `openssl rand -hex 32`).
# API_ACTOR_ID: NIM/user id user terdaftar; aksi bot tercatat atas nama user ini
# dan user harus role bendahara untuk endpoint tulis (POST).
API_KEY=
API_ACTOR_ID=
# Chatbot AI di /chat (opsional). Tanpa key ini halaman tetap terbuka tetapi
# menampilkan notice "belum dikonfigurasi". Model bisa diganti lewat GEMINI_MODEL.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Kuota anti-limit (free tier menghitung request, bukan token).
# 1 pertanyaan bisa memakan 2-3 request (jawaban + putaran tool + resume approval).
# AI_USER_PER_5MIN: batas per user per jendela 5 menit (default 10).
# AI_GLOBAL_PER_DAY: batas pertanyaan seluruh kelas per hari (default 80).
# Setel AI_GLOBAL_PER_DAY ~= RPD model di AI Studio / 2.5.
AI_USER_PER_5MIN=10
AI_GLOBAL_PER_DAY=80
# Kill switch: isi 1 untuk mematikan chatbot tanpa deploy ulang.
AI_DISABLED=
