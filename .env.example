# Salin ke .env lokal (jangan commit). Di Vercel: set di
# Project Settings → Environment Variables (Production + Preview).
# JANGAN beri prefix VITE_ pada secret di bawah ini.

# Random string panjang untuk Better Auth session encryption.
BETTER_AUTH_SECRET=
# URL publik aplikasi, tanpa trailing slash.
# Lokal: http://localhost:3000
# Production: https://<domain-anda>
BETTER_AUTH_URL=http://localhost:3000
# Postgres connection string. Untuk serverless, pakai endpoint pooler
# dari penyedia (Neon/Supabase/pgBouncer), tambahkan ?sslmode=require
# bila penyedia serverless membutuhkannya.
DATABASE_URL=postgresql://user:password@localhost:5432/bendahara
# Opsional: batasi koneksi pg.Pool per instance serverless (default 5).
PGPOOL_MAX=5
# Google OAuth (console.cloud.google.com). Redirect URI yang didaftarkan
# harus persis: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
