{
  "compilerOptions": {
    "jsx": "react-jsx",
    "moduleResolution": "Bundler",
    "module": "ESNext",
    "target": "ES2022",
    "skipLibCheck": true,
    "strictNullChecks": true,
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "types": ["bun", "vite/client"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["**/*"],
  "exclude": ["node_modules", "dist", ".tanstack"]
}
